{
  "name": "folioprism",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "description": "FolioPrism（棱阅）：本地优先的多媒体文档与双语阅读工作台，支持 Markdown / PDF / Office / 代码与音视频",
  "main": "main.js",
  "scripts": {
    "setup": "node prepare-vendor.js",
    "web": "node server.js",
    "start": "electron .",
    "predist": "node prepare-vendor.js",
    "dist": "node pack.js",
    "verify": "node verify.js",
    "verify:dist": "node verify-release.js",
    "test": "node --test test/tts_unit.test.js test/text_render_unit.test.js test/formats_unit.test.js",
    "test:open": "node test/open_file_smoke.js",
    "test:e2e": "node test/e2e_real_tts.js",
    "test:packaged": "node test/packaged_smoke.js"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.10.0",
    "dompurify": "^3.4.18",
    "mammoth": "^1.8.0",
    "marked": "^15.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.6.0"
  }
}
